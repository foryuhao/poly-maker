+                trade_id="iter0029-cancel-race-fill",
+            ))
+        return original_cancel(order_ids)
+
+    client.cancel_orders = cancel_with_late_fill
+    scope.session._sleep = hold_repair_poll
+    operation = asyncio.create_task(scope.session.continue_rebalance(
+        authorization=True, order_budget_s=1, close_budget_s=1,
