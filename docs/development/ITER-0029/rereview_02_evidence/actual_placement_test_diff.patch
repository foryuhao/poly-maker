+async def test_rebalance_session_teardown_drains_then_closes_repair_scope(
+    placement_scope, blocked_network, monkeypatch,
+):
+    scope = placement_scope
+    await _complete_cycle_with_confirmed_fill(scope, size=5)
+    client, gateway = await _prepare_repeated_continuation(
+        scope, monkeypatch, [("foreign-token", 0)], initial_size=None,
+    )
+    scope.session._market_data_max_age_s = 60
+    entered, release = asyncio.Event(), asyncio.Event()
+    original_sleep = scope.session._sleep
+    held = False
+
+    async def hold_repair_wait(delay):
+        nonlocal held
+        if client.posts == 1 and not held:
+            held = True
+            entered.set()
+            await release.wait()
+        await original_sleep(delay)
+
+    scope.session._sleep = hold_repair_wait
+    operation = asyncio.create_task(scope.session.continue_rebalance(
+        authorization=True, order_budget_s=1, close_budget_s=1,
+    ))
+    try:
+        await asyncio.wait_for(entered.wait(), 2)
+        teardown = asyncio.create_task(scope.session.aclose())
+        release.set()
+        _continuation_result, teardown_result = await asyncio.wait_for(
