+            held = True
+            entered.set()
+            await release.wait()
+        await original_sleep(delay)
+
+    original_cancel = client.cancel_orders
+    raced = False
+
+    def cancel_with_late_fill(order_ids):
+        nonlocal raced
+        if order_ids == ["cycle-1-no-token"] and not raced:
+            raced = True
+            row = client.rows[order_ids[0]]
+            _send_matched_then_confirmed(
+                scope, order_ids[0], trade_id="iter0029-cancel-race-fill",
+                size=2, price=float(row["price"]),
