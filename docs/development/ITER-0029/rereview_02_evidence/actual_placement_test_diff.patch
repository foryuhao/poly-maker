+@pytest.mark.asyncio
+@pytest.mark.parametrize("change", ["ask", "tick"])
+async def test_rebalance_rechecks_tick_target_after_account_read_await(
+    placement_scope, blocked_network, monkeypatch, change,
+):
+    scope = placement_scope
+    await _complete_cycle_with_confirmed_fill(scope, size=5)
+    fills = ([ ("foreign-token", 0), ("foreign-token", 0) ]
+             if change == "tick" else
+             [("foreign-token", 0), ("no-token", 5), ("yes-token", 5)])
+    client, gateway = await _prepare_repeated_continuation(
+        scope, monkeypatch, fills, initial_size=None,
+    )
+    scope.session._market_data_max_age_s = 60
+    import polymaker.rdp_runtime as runtime
+    old_capture = runtime._capture_account_with_gateway
+    mutated = False
+
+    async def mutate_book_after_account_read(*args, **kwargs):
+        nonlocal mutated
+        evidence = await old_capture(*args, **kwargs)
+        if client.posts == 1 and not mutated:
+            mutated = True
+            book = scope.session.public_session.service.book("no-token")
+            if change == "ask":
+                book.apply_delta(Side.SELL, .48, 0, time.time())
+                book.apply_delta(Side.SELL, .49, 10, time.time())
+            else:
+                scope.session.public_session.service._on_tick_change({
+                    "asset_id": "no-token", "new_tick_size": ".001",
+                })
+                scope.session.public_session.service._tick_source[
+                    "no-token"
+                ] = "WS_TICK_SIZE_CHANGE"
+        return evidence
+
+    monkeypatch.setattr(runtime, "_capture_account_with_gateway",
+                        mutate_book_after_account_read)
+    original_now = scope.session._now
+    if change == "tick":
+        original_post = client.post_orders
+
+        def exhaust_after_tick_replacement(*args, **kwargs):
+            acknowledgments = original_post(*args, **kwargs)
+            if client.posts == 2:
+                scope.session._now = lambda: scope.bootstrap.end_epoch - .01
+            return acknowledgments
+
+        client.post_orders = exhaust_after_tick_replacement
+    try:
+        result = await asyncio.wait_for(scope.session.continue_rebalance(
+            authorization=True, order_budget_s=1, close_budget_s=1,
+        ), timeout=5)
+    finally:
+        scope.session._now = original_now
+        gateway.close()
+
+    assert mutated
+    expected_reprice = .48 if change == "ask" else .479
+    assert [order.price for order in client.created[:2]] == pytest.approx(
+        [.47, expected_reprice],
+    )
+    assert client.cancel_calls[0] == ("cycle-1-no-token",)
+    assert client.events.index(("CANCEL", ("cycle-1-no-token",))) < client.events.index(("POST", 2))
+    if change == "tick":
+        assert result.outcome == "TERMINAL" and result.reason == "TIME_EXHAUSTED"
+        assert client.posts == 2
+        assert client.cancel_calls == [
+            ("cycle-1-no-token",), ("cycle-2-no-token",),
+        ]
+    else:
+        assert result.outcome in {"NORMAL_HANDOFF", "REBALANCE_HANDOFF"}
+    assert blocked_network == []
+
