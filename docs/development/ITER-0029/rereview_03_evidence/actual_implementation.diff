+@pytest.mark.parametrize("failure", [
+    "time", "market", "state", "capital",
+])
+async def test_rebalance_safety_stop_closes_scope_without_reposting(
+    placement_scope, blocked_network, monkeypatch, failure,
+):
+    scope = placement_scope
+    await _complete_cycle_with_confirmed_fill(scope, size=5)
+    client, gateway = await _prepare_repeated_continuation(
+        scope, monkeypatch, [("foreign-token", 0)], initial_size=None,
+    )
+    scope.session._market_data_max_age_s = 60
+    entered, release = asyncio.Event(), asyncio.Event()
+    old_sleep = scope.session._sleep
+    held = False
+
+    async def hold_one_repair_poll(delay):
+        nonlocal held
+        if client.posts == 1 and not held:
+            held = True
+            entered.set()
+            await release.wait()
+        await old_sleep(delay)
+
+    scope.session._sleep = hold_one_repair_poll
+    original_now = scope.session._now
+    if failure == "market":
+        import polymaker.rdp_runtime as runtime
+        old_status = runtime.read_rdp_market_status
+        reject_status = False
+
+        async def untradable_status(bootstrap, origin, *, now):
+            status = await old_status(bootstrap, origin, now=now)
+            return (replace(status, accepting_orders=False)
+                    if reject_status else status)
+
+        monkeypatch.setattr(runtime, "read_rdp_market_status", untradable_status)
+    elif failure == "capital":
+        import polymaker.rdp_runtime as runtime
+        old_capture = runtime._capture_account_with_gateway
+        old_backing = runtime.evaluate_current_rdp_backing
+        backing_reasons = []
+
+        async def insufficient_cash(*args, **kwargs):
+            evidence = await old_capture(*args, **kwargs)
+            if held:
+                return SimpleNamespace(
+                    **{**vars(evidence), "balance_usd": Decimal("0"),
+                       "allowance_usd": Decimal("0")},
+                )
+            return evidence
+
+        def inspect_backing(*args, **kwargs):
+            result = old_backing(*args, **kwargs)
+            backing_reasons.append(result.reason)
+            return result
+
+        monkeypatch.setattr(runtime, "_capture_account_with_gateway", insufficient_cash)
+        monkeypatch.setattr(runtime, "evaluate_current_rdp_backing", inspect_backing)
+
+    operation = asyncio.create_task(scope.session.continue_rebalance(
+        authorization=True, order_budget_s=1, close_budget_s=1,
+    ))
+    try:
+        await asyncio.wait_for(entered.wait(), 2)
+        assert client.posts == 1 and client.cancel_calls == []
+        if failure == "time":
+            scope.session._now = lambda: scope.bootstrap.end_epoch - .01
+        elif failure == "state":
+            scope.session.public_session.service.connection_generation += 1
+        elif failure == "market":
+            reject_status = True
+        release.set()
+        with _capture_structlog_event_dicts() as stop_events:
+            result = await asyncio.wait_for(operation, timeout=4)
+    finally:
+        release.set()
+        scope.session._sleep = old_sleep
+        scope.session._now = original_now
+        if not operation.done():
+            operation.cancel()
+        gateway.close()
+
+    expected = {
+        "time": "TIME_EXHAUSTED",
+        "market": "MARKET_NOT_TRADABLE",
+        "state": "STATE_UNRELIABLE",
+        "capital": "CAPITAL_INSUFFICIENT",
+    }[failure]
+    assert result.outcome == "TERMINAL"
+    if failure == "capital":
+        assert "INSUFFICIENT_CURRENT_CASH" in backing_reasons
+    assert result.reason == expected
+    assert scope.session._terminal_stop_reason == expected
+    terminal = scope.session.terminal_failure_result
+    assert terminal is not None and terminal.stop_reason == expected
+    required_events = [
+        row for row in stop_events
+        if row.get("event") in {
+            "rdp_terminal_stop_latched", "rdp_terminal_failure_finished",
+            "rdp_rebalance_stopped",
+        }
+    ]
+    assert required_events
+    assert all(row.get("stop_reason") == expected for row in required_events)
+    assert client.posts == 1
+    assert client.cancel_calls == [("cycle-1-no-token",)]
+    assert result.cycles[-1].close_result.barrier_complete
+    assert result.cycles[-1].close_result.replacement_blocked is (
+        failure == "state"
+    )
+    assert blocked_network == []
+
