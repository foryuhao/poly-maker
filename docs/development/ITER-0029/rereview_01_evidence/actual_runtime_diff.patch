+def _safe_book_price(book: Any, side: str) -> float | None:
+    view = getattr(book, "view", None)
+    if callable(view):
+        try:
+            view = view()
+        except Exception:
+            return None
+    price = getattr(view, side, None)
+    if (isinstance(price, bool) or not isinstance(price, (int, float))
+            or not math.isfinite(price)):
+        return None
+    return float(price)
