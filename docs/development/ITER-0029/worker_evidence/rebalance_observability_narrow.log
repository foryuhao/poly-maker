                    continue
                self._latch_terminal_stop(reason)
                return self._continuation_completion(
                    "TERMINAL", reason, mode=None, submissions=submissions,
                    cycles=cycles, admissions=admissions,
                )
            if admission.mode is RDPMode.NORMAL:
