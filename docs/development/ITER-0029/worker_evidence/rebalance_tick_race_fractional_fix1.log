    @pytest.mark.asyncio
    async def test_rebalance_cancel_race_fill_is_reconciled_before_normal_recovery(
        placement_scope, blocked_network, monkeypatch,
    ):
        scope = placement_scope
        await _complete_cycle_with_confirmed_fill(scope, size=5)
        client, gateway = await _prepare_repeated_continuation(
            scope, monkeypatch, [("foreign-token", 0), ("yes-token", 5)],
            initial_size=None,
        )
        scope.session._market_data_max_age_s = 60
        entered, release = asyncio.Event(), asyncio.Event()
        original_sleep = scope.session._sleep
        held = False
    
        async def hold_repair_poll(delay):
            nonlocal held
            if client.posts == 1 and not held:
                held = True
                entered.set()
                await release.wait()
            await original_sleep(delay)
    
        original_cancel = client.cancel_orders
        raced = False
    
        def cancel_with_late_fill(order_ids):
            nonlocal raced
            if order_ids == ["cycle-1-no-token"] and not raced:
                raced = True
                row = client.rows[order_ids[0]]
                _send_matched_then_confirmed(
                    scope, order_ids[0], trade_id="iter0029-cancel-race-fill",
                    size=2, price=float(row["price"]),
                    receipt_ns=scope.session._monotonic_ns(),
                )
                row["size_matched"] = "2"
                row["status"] = "LIVE"
                client.trades.append(_rest_trade(
                    order_ids[0], "no-token", row["price"], "2",
                    trade_id="iter0029-cancel-race-fill",
                ))
            return original_cancel(order_ids)
    
        client.cancel_orders = cancel_with_late_fill
        scope.session._sleep = hold_repair_poll
        operation = asyncio.create_task(scope.session.continue_rebalance(
            authorization=True, order_budget_s=1, close_budget_s=1,
        ))
        try:
            await asyncio.wait_for(entered.wait(), 2)
            no_book = scope.session.public_session.service.book("no-token")
            no_book.apply_delta(Side.SELL, .48, 0, time.time())
            no_book.apply_delta(Side.SELL, .49, 10, time.time())
            release.set()
