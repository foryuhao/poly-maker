    @pytest.mark.asyncio
    @pytest.mark.parametrize("change", ["ask", "tick"])
    async def test_rebalance_rechecks_tick_target_after_account_read_await(
        placement_scope, blocked_network, monkeypatch, change,
    ):
        scope = placement_scope
        await _complete_cycle_with_confirmed_fill(scope, size=5)
        client, gateway = await _prepare_repeated_continuation(
            scope, monkeypatch,
            [("foreign-token", 0), ("no-token", 5), ("yes-token", 5)],
            initial_size=None,
        )
        scope.session._market_data_max_age_s = 60
        import polymaker.rdp_runtime as runtime
        old_capture = runtime._capture_account_with_gateway
        mutated = False
    
        async def mutate_book_after_account_read(*args, **kwargs):
            nonlocal mutated
            evidence = await old_capture(*args, **kwargs)
            if client.posts == 1 and not mutated:
                mutated = True
                book = scope.session.public_session.service.book("no-token")
                if change == "ask":
                    book.apply_delta(Side.SELL, .48, 0, time.time())
                    book.apply_delta(Side.SELL, .49, 10, time.time())
                else:
                    book.set_tick_size(.05)
                    scope.session.public_session.service._tick_source[
                        "no-token"
                    ] = "WS_TICK_SIZE_CHANGE"
            return evidence
    
        monkeypatch.setattr(runtime, "_capture_account_with_gateway",
                            mutate_book_after_account_read)
        try:
>           result = await asyncio.wait_for(scope.session.continue_rebalance(
                authorization=True, order_budget_s=1, close_budget_s=1,
            ), timeout=5)

