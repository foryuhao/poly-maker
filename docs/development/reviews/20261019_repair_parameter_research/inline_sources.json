{
  "schemaVersion": 1,
  "items": [
    {
      "id": "sample-coverage",
      "title": "研究样本与行情恢复检查",
      "queries": [
        {
          "id": "raw-stream-coverage",
          "source": {
            "label": "Shadow原始事件与归档快照",
            "files": [
              {
                "label": "raw_manifest.json"
              },
              {
                "label": "validation.json"
              }
            ],
            "metricDefinitions": [
              {
                "label": "原始事件",
                "definition": "逐行按记录可用时间恢复47个市场的双侧盘口顶价，原始文件读取时计算SHA-256。"
              }
            ],
            "filters": [
              "输入：47个本地Shadow事件流",
              "比较：相同实际时间、归档有效p且通过研究过滤的记录"
            ],
            "caveats": [
              "10,054个归档有效p中有7个未通过更严格的研究过滤。",
              "固定NORMAL的13个实际episode与这47个市场不重合。"
            ]
          },
          "columns": [
            "markets",
            "raw_events",
            "raw_bytes",
            "exact_p_comparisons",
            "different_p_comparisons"
          ],
          "rows": [
            {
              "markets": 47,
              "raw_events": 17571689,
              "raw_bytes": 21155061498,
              "exact_p_comparisons": 10047,
              "different_p_comparisons": 0
            }
          ]
        }
      ]
    },
    {
      "id": "tp-target",
      "title": "TP收益目标候选与早触发行为",
      "queries": [
        {
          "id": "tp-sensitivity",
          "source": {
            "label": "REPAIR历史参数研究",
            "files": [
              {
                "label": "evidence.json"
              },
              {
                "label": "candidate_summary.csv"
              }
            ],
            "filters": [
              "市场：47个本地真实Shadow市场，排除测试目录",
              "入场：T40至T110，每10秒、双向、初始5 share，需当时可靠p及sigma",
              "行情：同代、双侧新鲜BBO、mid互补误差≤0.02，保守排除端点报价",
              "缺失处理：首次无效报价或换代即右删失，不跨段插值"
            ],
            "caveats": [
              "标准路径探针不是固定NORMAL实际成交；704条路径属于47个市场簇。",
              "本研究只比较退出意图及价格路径，不能证明Maker成交率、最终收益或正EV。",
              "r=0.002是起始设计取舍，不是收益最优解；不新增最小持有时间。",
              "best bid成本是假设在该价取得仓位，不代表真实Maker已成交。"
            ],
            "metricDefinitions": [
              {
                "label": "r_TP",
                "definition": "TP阈值为当前公平价浮盈/原始实际Q0 > r_TP × 第一笔成交后的持有秒数；单位USDC/(原始share·秒)。"
              },
              {
                "label": "先TP比例",
                "definition": "在路径SL或删失之前首先提出TP意图的路径数/全部该组探针数。"
              }
            ]
          },
          "columns": [
            "r_tp",
            "fair_tp_first_pct",
            "bid_cost_tp_first_pct",
            "fair_tp_by_2s_pct"
          ],
          "rows": [
            {
              "r_tp": 0.001,
              "fair_tp_first_pct": 67.1875,
              "bid_cost_tp_first_pct": 82.24431818181819,
              "fair_tp_by_2s_pct": 42.04545454545455
            },
            {
              "r_tp": 0.002,
              "fair_tp_first_pct": 63.21022727272727,
              "bid_cost_tp_first_pct": 80.82386363636364,
              "fair_tp_by_2s_pct": 42.04545454545455
            },
            {
              "r_tp": 0.003,
              "fair_tp_first_pct": 61.22159090909091,
              "bid_cost_tp_first_pct": 79.54545454545455,
              "fair_tp_by_2s_pct": 42.04545454545455
            },
            {
              "r_tp": 0.005,
              "fair_tp_first_pct": 51.42045454545455,
              "bid_cost_tp_first_pct": 55.96590909090909,
              "fair_tp_by_2s_pct": 35.9375
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "TP条件：m_episode > r_TP * tau_hold\nQ0=5，r_TP=0.002：10/30/60秒的总浮盈门槛分别为0.10/0.30/0.60 USDC。"
            }
          ]
        }
      ]
    },
    {
      "id": "sl-path",
      "title": "路径SL的触发速度与回弹代价",
      "queries": [
        {
          "id": "sl-thresholds",
          "source": {
            "label": "REPAIR历史参数研究",
            "files": [
              {
                "label": "evidence.json"
              },
              {
                "label": "candidate_summary.csv"
              }
            ],
            "filters": [
              "市场：47个本地真实Shadow市场，排除测试目录",
              "入场：T40至T110，每10秒、双向、初始5 share，需当时可靠p及sigma",
              "行情：同代、双侧新鲜BBO、mid互补误差≤0.02，保守排除端点报价",
              "缺失处理：首次无效报价或换代即右删失，不跨段插值"
            ],
            "caveats": [
              "标准路径探针不是固定NORMAL实际成交；704条路径属于47个市场簇。",
              "本研究只比较退出意图及价格路径，不能证明Maker成交率、最终收益或正EV。",
              "TP提出后仍按未配平处理；报价穿价不作为实际退出。",
              "推荐组合是积极止损：89.49%的仍未配平探针最终出现路径SL。",
              "回弹与继续恶化事件可以重叠，不能相加或解释为盈利概率。"
            ],
            "metricDefinitions": [
              {
                "label": "路径SL",
                "definition": "2秒逆向幅度达到max(2 tick,1.5×事前sigma×sqrt(2秒))，或价格贡献/原始Q0从峰值回吐达到所比较门槛。"
              },
              {
                "label": "10秒回弹",
                "definition": "未来10个1秒观察都可靠的路径中，回到冲击前价格或累计回吐峰值参考位的比例。"
              }
            ]
          },
          "columns": [
            "drawdown_spec",
            "path_sl_holding_median_s",
            "known_10s_followups",
            "recovered_reference_10s_pct"
          ],
          "rows": [
            {
              "drawdown_spec": "fixed04",
              "path_sl_holding_median_s": 7.0,
              "known_10s_followups": 639,
              "recovered_reference_10s_pct": 31.92488262910798
            },
            {
              "drawdown_spec": "fixed06",
              "path_sl_holding_median_s": 10.0,
              "known_10s_followups": 624,
              "recovered_reference_10s_pct": 28.365384615384617
            },
            {
              "drawdown_spec": "fixed08",
              "path_sl_holding_median_s": 12.0,
              "known_10s_followups": 619,
              "recovered_reference_10s_pct": 27.140549273021
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "L = sum(Delta_episode_before_segment * delta_p) / original_Q0\nD = max(0, historical_max(L)) - L\nD >= 0.06 => SL，独立于当前PnL正负；部分成交不重置Q0。"
            }
          ]
        }
      ]
    },
    {
      "id": "known-shock",
      "title": "已讨论的第10→11窗口应进入SL",
      "queries": [
        {
          "id": "known-case-audit",
          "source": {
            "label": "20261018实盘81条旧决策记录",
            "files": [
              {
                "label": "special_case.csv"
              },
              {
                "label": "decisions.csv"
              }
            ],
            "filters": [
              "方向：YES，原仓5@0.53",
              "点：旧决策第10与11的模型输入时点"
            ],
            "caveats": [
              "这是已知问题案例的解释性复核，不是独立参数验证。",
              "旧日志不等于新策略已下单或一定能在历史价格成交。"
            ]
          },
          "columns": [
            "decision",
            "t",
            "adverse",
            "previous_h",
            "z",
            "no_bid",
            "no_ask"
          ],
          "rows": [
            {
              "decision": 11,
              "t": 70.0499758720398,
              "adverse": 0.050000000000000044,
              "previous_h": 2.636608839035034,
              "z": 1.6418829792458165,
              "no_bid": 0.37,
              "no_ask": 0.38
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "0.05 / (0.0187544767 * sqrt(2.636608839)) = 1.641883 >= 1.5\n若仍未配平，进入/升级SL；该点ask-tick = 0.38-0.01 = 0.37。"
            }
          ]
        }
      ]
    }
  ]
}