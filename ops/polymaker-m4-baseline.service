[Unit]
Description=PolyMaker M4 baseline simulation
After=network-online.target
StartLimitIntervalSec=0
ConditionPathExists=!/home/ubuntu/polymaker/runtime/trading-control/m4-baseline-stop.json

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/polymaker
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/polymaker/.venv/bin/python -B -m polymaker.m4_run --project-dir /home/ubuntu/polymaker --mode baseline
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
