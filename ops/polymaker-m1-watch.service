[Unit]
Description=Audit M1, stop live below 20 USDC, and wake its Codex chat
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/polymaker
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/polymaker/.venv/bin/python /home/ubuntu/polymaker/ops/m1_live_watch.py --project-dir /home/ubuntu/polymaker --thread 01a19f0f-b745-7111-9a8d-7305d5bda514
Nice=15
TimeoutStartSec=90
