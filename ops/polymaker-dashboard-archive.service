[Unit]
Description=PolyMaker independent read-only dashboard and five-minute archive

[Service]
Type=simple
WorkingDirectory=%h/poly-maker
ExecStart=%h/poly-maker/.venv/bin/python -m polymaker.dashboard archive --project-dir %h/poly-maker --output-dir %h/poly-maker/research_outputs/dashboard
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=15%
MemoryMax=256M
IOWeight=10
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX
UMask=0077
TimeoutStopSec=15

[Install]
WantedBy=default.target
