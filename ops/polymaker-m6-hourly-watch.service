[Unit]
Description=M6 baseline hourly inspection and report to authorized chat
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/polymaker
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/polymaker/.venv/bin/python -B /home/ubuntu/polymaker/ops/m6_hourly_watch.py
Nice=15
TimeoutStartSec=600
