[Unit]
Description=Retain 24 hours of completed M1 logs and preserve all ledgers and study300
RequiresMountsFor=@PROJECT_DIR@

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/poly-maker/ca_log_retention.py --data-root "@PROJECT_DIR@" --state-dir "@PROJECT_DIR@/logs/retention" --apply
TimeoutStartSec=10min
Nice=19
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=128M
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths="@PROJECT_DIR@/journal" "@PROJECT_DIR@/logs/retention"
ReadWritePaths=-"@PROJECT_DIR@/livecfg/journal"
ReadWritePaths=-"@PROJECT_DIR@/research_outputs/m1_virtual/sessions"
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
